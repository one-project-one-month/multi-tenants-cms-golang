{
  "swagger": "2.0",
  "info": {
    "title": "LMS Authentication Service",
    "description": "API for user authentication in the Learning Management System",
    "version": "1.0",
    "contact": {
      "name": "LMS Team",
      "url": "https://lms.example.com/support",
      "email": "support@lms.example.com"
    },
    "license": {
      "name": "Apache 2.0",
      "url": "https://www.apache.org/licenses/LICENSE-2.0.html"
    }
  },
  "tags": [
    {
      "name": "AuthenticationService"
    }
  ],
  "host": "api.lms.example.com",
  "basePath": "/v1",
  "schemes": [
    "https",
    "http"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/lms/v1/auth/login": {
      "post": {
        "summary": "User login",
        "description": "Authenticates user credentials and returns access tokens",
        "operationId": "AuthenticationService_Login",
        "responses": {
          "200": {
            "description": "Login successful",
            "schema": {
              "$ref": "#/definitions/LoginResponse"
            }
          },
          "401": {
            "description": "Invalid credentials",
            "schema": {}
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/authenticationLoginRequest"
            }
          }
        ],
        "tags": [
          "Authentication"
        ]
      }
    },
    "/lms/v1/auth/logout": {
      "post": {
        "summary": "User logout",
        "description": "Invalidates the user's authentication tokens",
        "operationId": "AuthenticationService_LogOut",
        "responses": {
          "200": {
            "description": "Logout successful",
            "schema": {
              "$ref": "#/definitions/LogoutResponse"
            }
          },
          "401": {
            "description": "Invalid or missing token",
            "schema": {}
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/authenticationLoginOutRequest"
            }
          }
        ],
        "tags": [
          "Authentication"
        ],
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    },
    "/lms/v1/auth/register": {
      "post": {
        "summary": "Register new user",
        "description": "Creates a new user account in the LMS system",
        "operationId": "AuthenticationService_Register",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/authenticationRegisterResponse"
            }
          },
          "201": {
            "description": "User successfully registered",
            "schema": {
              "$ref": "#/definitions/RegisterResponse"
            }
          },
          "400": {
            "description": "Invalid request parameters",
            "schema": {}
          },
          "409": {
            "description": "User already exists",
            "schema": {}
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/authenticationRegisterRequest"
            }
          }
        ],
        "tags": [
          "Authentication"
        ]
      }
    },
    "/lms/v1/auth/resend/{email}": {
      "post": {
        "summary": "Resend verification email",
        "description": "Resends the email verification token to the specified email address",
        "operationId": "AuthenticationService_ResendVerificationEmail",
        "responses": {
          "200": {
            "description": "Verification email resent",
            "schema": {
              "$ref": "#/definitions/ResendVerificationResponse"
            }
          },
          "404": {
            "description": "Email not found",
            "schema": {}
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "email",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "organisation",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "Authentication"
        ]
      }
    },
    "/lms/v1/auth/verify-email/{email}/{token}": {
      "post": {
        "summary": "Verify email address",
        "description": "Verifies a user's email address using the token sent to their email",
        "operationId": "AuthenticationService_VerifyEmail",
        "responses": {
          "200": {
            "description": "Email successfully verified",
            "schema": {
              "$ref": "#/definitions/EmailVerifyResponse"
            }
          },
          "400": {
            "description": "Invalid or expired token",
            "schema": {}
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "email",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "token",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/AuthenticationServiceVerifyEmailBody"
            }
          }
        ],
        "tags": [
          "Authentication"
        ]
      }
    }
  },
  "definitions": {
    "AuthenticationServiceVerifyEmailBody": {
      "type": "object",
      "properties": {
        "organisation": {
          "type": "string"
        }
      }
    },
    "authenticationEmailVerifyResponse": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        }
      }
    },
    "authenticationLoginOutRequest": {
      "type": "object",
      "properties": {
        "organisation": {
          "type": "string"
        },
        "email": {
          "type": "string"
        }
      }
    },
    "authenticationLoginRequest": {
      "type": "object",
      "properties": {
        "organisation": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "password": {
          "type": "string"
        }
      }
    },
    "authenticationLoginResponse": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        },
        "token": {
          "type": "string"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "authenticationLogoutResponse": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        }
      }
    },
    "authenticationRegisterRequest": {
      "type": "object",
      "properties": {
        "organisation": {
          "type": "string"
        },
        "username": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "phoneNumber": {
          "type": "string"
        },
        "mfaVerificationOption": {
          "type": "boolean"
        }
      }
    },
    "authenticationRegisterResponse": {
      "type": "object",
      "properties": {
        "registeredUser": {
          "$ref": "#/definitions/authenticationSystemUser"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "authenticationResendVerificationResponse": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        },
        "success": {
          "type": "boolean"
        }
      }
    },
    "authenticationSystemUser": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "username": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "phoneNumber": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "emailVerified": {
          "type": "boolean"
        },
        "mfaEnable": {
          "type": "boolean"
        },
        "registrationDate": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "title": "Is equal to the LMS USER"
    },
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    }
  },
  "securityDefinitions": {
    "Bearer": {
      "type": "apiKey",
      "description": "Authentication token, prefixed with Bearer",
      "name": "Authorization",
      "in": "header"
    }
  },
  "security": [
    {
      "Bearer": []
    }
  ]
}

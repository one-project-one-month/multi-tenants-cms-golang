#### LOGIN REQUEST
POST  {{lms_url}}/lms/v1/auth/login
accept: application/json
X-Organisation: tenant_namespace_1
Content-Type: application/json

{
  "namespace_domain_email": "swan100222@tenant_namespace_1.edu",
  "password": "SwanHtet12@"

}


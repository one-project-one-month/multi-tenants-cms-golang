    "/lms/v1/auth/login": {
      "post": {
        "summary": "User login",
        "description": "Authenticates user credentials and returns access tokens",
        "operationId": "AuthenticationService_Login",
        "responses": {
          "200": {
            "description": "Login successful",
            "schema": {
              "$ref": "#/definitions/LoginResponse"
            }
          },
          "401": {
            "description": "Invalid credentials",
            "schema": {}
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/googlerpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/authenticationLoginRequest"
            }
          },
          {
            "name": "X-Organisation",
            "description": "Organization identifier header",
            "in": "header",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "Authentication"
        ]
      }
    },
    "/lms/v1/auth/logout": {
      "post": {
        "summary": "User logout",
        "description": "Invalidates the user's authentication tokens",
        "operationId": "AuthenticationService_LogOut",
        "responses": {
          "200": {
            "description": "Logout successful",
            "schema": {
              "$ref": "#/definitions/LogoutResponse"
            }
          },
          "401": {
            "description": "Invalid or missing token",
            "schema": {}
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/googlerpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/authenticationLoginOutRequest"
            }
          },
          {
            "name": "X-Organisation",
            "description": "Organization identifier header",
            "in": "header",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "Authentication"
        ],
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    },
    "/lms/v1/auth/refresh": {
      "post": {
        "summary": "Refresh Token",

# =============================================================================
# MULTI-TENANT CMS ENVIRONMENT CONFIGURATION
# Version: 1.0.0
# Last Updated: 2025-07-16
# =============================================================================

# =============================================================================
# APPLICATION ENVIRONMENT
# =============================================================================
APP_ENV=development
CMS_APP_STATUS=development
SPRING_PROFILES_ACTIVE=docker
DEBUG_MODE=true
TZ=UTC
DEFAULT_TIMEZONE=UTC

# =============================================================================
# SERVICE PORTS
# =============================================================================
CMS_PORT=8080
EMAIL_SERVICE_PORT=8080
LMS_HTTP_PORT=8080
LMS_GRPC_PORT=9090
FILE_SERVICE_PORT=9009

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# CMS Database
CMS_DB_HOST=postgres-cms
CMS_DB_PORT=5432
POSTGRES_CMS_DB=cms_db
POSTGRES_CMS_USER=postgres
POSTGRES_CMS_PASSWORD=cms_password_123

# LMS Database
POSTGRES_LMS_DB=lms_db
POSTGRES_LMS_USER=lms_user
POSTGRES_LMS_PASSWORD=lms_password
LMS_DB_SOURCE=postgresql://${POSTGRES_LMS_USER}:${POSTGRES_LMS_PASSWORD}@postgres-lms:5433/${POSTGRES_LMS_DB}?sslmode=disable

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_TTL=3600
CACHE_ENABLED=true
CACHE_PREFIX=multi_tenant_cms

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
JWT_SECRET=your_jwt_secret_here_make_it_long_and_secure_32_chars_minimum
ENCRYPTION_KEY=your_encryption_key_here_32_characters_long

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
CORS_ALLOW_CREDENTIALS=true
CMS_ALLOWED_ORIGIN="*"

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST_SIZE=10

# =============================================================================
# SERVICE DISCOVERY - CONSUL
# =============================================================================
CONSUL_ENABLED=true
CONSUL_ADDRESS=consul:8500
CONSUL_DATACENTER=dc1
CONSUL_SCHEME=http
CONSUL_TOKEN=
CONSUL_BIND_INTERFACE=eth0
CONSUL_CLIENT_INTERFACE=eth0

# CMS Service Registration
CMS_SERVICE_ID=cms-api-1
CMS_SERVICE_NAME=cms-service
CMS_SERVICE_TAGS=cms,multi-tenant,api,v1,environment:development
CMS_CHECK_TTL=30s
CMS_CHECK_ID=service-check-cms-api-1

# Email Service Registration
EMAIL_SERVICE_ID=email-service-1
EMAIL_SERVICE_NAME=email-service
EMAIL_SERVICE_TAGS=email,messaging,service,v1,environment:development
EMAIL_CHECK_TTL=30s

# File Service Registration
FILE_SERVICE_ID=file-service-1
FILE_SERVICE_NAME=file-service
FILE_SERVICE_TAGS=file,storage,service,v1,environment:development
FILE_CHECK_TTL=30s
FILE_CHECK_ID=service-check-file-service-1

# LMS Service Registration
LMS_SERVICE_ID=lms-api-1
LMS_SERVICE_NAME=lms-service
LMS_SERVICE_TAGS=lms,multi-tenant,api,v1,environment:development
LMS_CHECK_TTL=30s
LMS_CHECK_ID=service-check-lms-api-1

# =============================================================================
# SECRETS MANAGEMENT - VAULT
# =============================================================================
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=root

# =============================================================================
# MESSAGE QUEUE - NATS
# =============================================================================
NATS_URL=nats://nats:4222
STREAM_NAME=email.notification
SUBJECT_TO=email.send
CONSUMER_NAME=email-consumer

# =============================================================================
# EMAIL SERVICE CONFIGURATION
# =============================================================================
# Email Provider Settings
EMAIL_PROVIDER=resend
FROM_EMAIL=swanhtetaungp@gmail.com
FROM_NAME=Swan
FROM_ADDR=swanhtetaungp@gmail.com
TEMPLATE_DIR=./templates

# Email Processing
EMAIL_RETRY_ATTEMPTS=3
EMAIL_RETRY_DELAY=5s
EMAIL_QUEUE_SIZE=1000
EMAIL_RATE_LIMIT_PER_MINUTE=60
EMAIL_RATE_LIMIT_PER_HOUR=1000

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=swanhtetaungp@gmail.com
SMTP_PASSWORD=igkjacrxwvisbmac

# =============================================================================
# EXTERNAL API KEYS
# =============================================================================
# GitHub Integration
GITHUB_TOKEN=your_github_token_here
GITHUB_OWNER=s
GITHUB_REPO=o

# Email Service Providers
SENDGRID_API_KEY=your_sendgrid_api_key_here
RESEND_API_KEY=your_resend_api_key_here

# External Services
EXTERNAL_API_URL=https://api.example.com
EXTERNAL_API_KEY=your_external_api_key_here

# =============================================================================
# FILE MANAGEMENT
# =============================================================================
MAX_FILE_SIZE=10MB
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,txt
UPLOAD_PATH=/app/uploads
STORAGE_PATH=/app/storage

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=info
LOG_CONSOLE=true
LOG_FILE_PATH=/app/logs/app.log
LOG_MAX_SIZE=100
LOG_MAX_BACKUPS=3
LOG_MAX_AGE=28
LOG_COMPRESS=true

# Dozzle UI Configuration
DOZZLE_LEVEL=info
DOZZLE_TAIL=300

# =============================================================================
# HEALTH CHECKS & MONITORING
# =============================================================================
HEALTH_CHECK_INTERVAL=10s
HEALTH_CHECK_TIMEOUT=5s
HEALTH_CHECK_RETRIES=5
HEALTH_CHECK_START_PERIOD=15s

# =============================================================================
# GRPC & HTTP SERVER ADDRESSES
# =============================================================================
LMS_GRPC_SERVER_ADDRESS=0.0.0.0:9090
LMS_HTTP_SERVER_ADDRESS=0.0.0.0:8080

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *

# =============================================================================
# DEVELOPMENT TOOLS
# =============================================================================
# Hot Reload
HOT_RELOAD_ENABLED=true
HOT_RELOAD_PATHS=./backend

# MailHog (Development Email Testing)
MAILHOG_ENABLED=false
MAILHOG_WEB_PORT=8025
MAILHOG_SMTP_PORT=1025

# =============================================================================
# PRODUCTION OVERRIDES
# Uncomment and modify for production deployment
# =============================================================================
# APP_ENV=production
# CMS_APP_STATUS=production
# DEBUG_MODE=false
# LOG_LEVEL=warn
# LOG_CONSOLE=false
#
# # Security
# CORS_ALLOWED_ORIGINS=https://yourdomain.com
# CMS_ALLOWED_ORIGIN=https://yourdomain.com
#
# # Email (Production SMTP)
# SMTP_HOST=smtp.yourdomain.com
# SMTP_PORT=587
# SMTP_USER=noreply@yourdomain.com
# SMTP_PASSWORD=your_production_smtp_password
# FROM_ADDR=noreply@yourdomain.com
# FROM_EMAIL=noreply@yourdomain.com
# FROM_NAME=Your Production App
#
# # Disable Development Tools
# HOT_RELOAD_ENABLED=false
# MAILHOG_ENABLED=false
#
# # Enhanced Security
# RATE_LIMIT_REQUESTS_PER_MINUTE=50
# RATE_LIMIT_BURST_SIZE=5

# =============================================================================
# ALTERNATIVE SMTP PROVIDERS
# Uncomment the provider you want to use
# =============================================================================
#
# # Outlook/Hotmail
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_USER=your-email@outlook.com
# SMTP_PASSWORD=your-password
#
# # Custom SMTP Server
# SMTP_HOST=mail.yourdomain.com
# SMTP_PORT=587
# SMTP_USER=noreply@yourdomain.com
# SMTP_PASSWORD=your-password
#
# # Development with MailHog
# SMTP_HOST=mailhog
# SMTP_PORT=1025
# SMTP_USER=test
# SMTP_PASSWORD=test

# =============================================================================
# END OF CONFIGURATION
# =============================================================================
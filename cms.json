{
  "info": {
    "_postman_id": "cms-auth-api-collection",
    "name": "CMS API",
    "description": "Complete authentication API for CMS system including registration, login, MFA, and profile management",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "cms-api"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"swanhtet102002@gmail.com\",\n  \"password\": \"Password1231\",\n  \"role\": \"CMS_CUSTOMER\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "register"
              ]
            }
          }
        },
        {
          "name": "Verify Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"swanhtet102002@gmail.com\",\n  \"code\": \"826127\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/verify-email",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "verify-email"
              ]
            }
          }
        },
        {
          "name": "Resend Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"swanhtet102002@gmail.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/resend",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "resend"
              ]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (responseCode.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.data && jsonData.data.access_token) {",
                  "        pm.environment.set('accessToken', jsonData.data.access_token);",
                  "    }",
                  "    if (jsonData.data && jsonData.data.refresh_token) {",
                  "        pm.environment.set('refreshToken', jsonData.data.refresh_token);",
                  "    }",
                  "    if (jsonData.data && jsonData.data.user && jsonData.data.user.cms_user_id) {",
                  "        pm.environment.set('userId', jsonData.data.user.cms_user_id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"swanhtet102002@gmail.com\",\n  \"password\": \"Password1231\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            }
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (responseCode.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.data && jsonData.data.access_token) {",
                  "        pm.environment.set('accessToken', jsonData.data.access_token);",
                  "    }",
                  "    if (jsonData.data && jsonData.data.refresh_token) {",
                  "        pm.environment.set('refreshToken', jsonData.data.refresh_token);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{refreshToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"refresh_token\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "refresh"
              ]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"refresh_token\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "logout"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "User Profile",
      "item": [
        {
          "name": "Get Me (Profile)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "me"
              ]
            }
          }
        },
        {
          "name": "Update User Profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Updated\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/profile/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "profile",
                "{{userId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "MFA (Multi-Factor Authentication)",
      "item": [
        {
          "name": "Setup MFA",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (responseCode.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.data && jsonData.data.setup_data && jsonData.data.setup_data.token_id) {",
                  "        pm.environment.set('tokenId', jsonData.data.setup_data.token_id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/mfa/setup/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "mfa",
                "setup",
                "{{userId}}"
              ]
            }
          }
        },
        {
          "name": "Verify MFA Setup",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"token_id\": {{tokenId}},\n    \"code\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/mfa/verify/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "mfa",
                "verify",
                "{{userId}}"
              ]
            }
          }
        },
        {
          "name": "Login with MFA",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mfa_code\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/mfa/login/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "mfa",
                "login",
                "{{userId}}"
              ]
            }
          }
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          ""
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          ""
        ]
      }
    }
  ],
  "variable": [

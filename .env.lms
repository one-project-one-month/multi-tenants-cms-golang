# =============================================================================
# LMS (Learning Management System) CONFIGURATION
# =============================================================================

# =============================================================================
# SERVICE PORTS
# =============================================================================
LMS_GRPC_SERVER_ADDRESS=:9001
LMS_GRPC_GATEWAY_ADDRESS=:8082
LMS_HTTP_PORT=8080
LMS_GRPC_PORT=9090

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
LMS_DB_HOST=ep-withered-salad-a27oo7gn-pooler.eu-central-1.aws.neon.tech
LMS_DB_PORT=5432
LMS_DB_NAME=neondb
LMS_DB_USER=neondb_owner
LMS_DB_PASSWORD=npg_MEB4CYJS7TKh
LMS_DB_MAX_CONNS=20
LMS_DB_MIN_CONNS=5
LMS_DB_MAX_CONN_LIFETIME=1h
LMS_DB_MAX_CONN_IDLE_TIME=30m
LMS_DB_SOURCE=postgresql://${LMS_DB_USER}:${LMS_DB_PASSWORD}@${LMS_DB_HOST}:${LMS_DB_PORT}/${LMS_DB_NAME}?sslmode=require&channel_binding=require
#'postgresql://neondb_owner:npg_MEB4CYJS7TKh@ep-withered-salad-a27oo7gn-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require'
# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
LMS_JWT_SECRET=your_jwt_secret_here_make_it_long_and_secure_32_chars_minimum
LMS_JWT_ISSUER=lms-system
LMS_JWT_AUDIENCE=lms-client
LMS_JWT_EXPIRATION=24h

# =============================================================================
# SERVICE DISCOVERY - CONSUL
# =============================================================================
LMS_CONSUL_ADDRESS=localhost:8500
LMS_SERVICE_ID=lms-service-1
LMS_SERVICE_NAME=lms-service
LMS_SERVICE_TAGS=lms,learning,api,v1,environment:development
LMS_CHECK_TTL=30s
LMS_CHECK_ID=service-check-lms-1

# =============================================================================
# GRPC & HTTP GATEWAY CONFIGURATION
# =============================================================================
LMS_GRPC_TIMEOUT=30s
LMS_HTTP_TIMEOUT=30s
LMS_GRPC_MAX_RECV_MSG_SIZE=25MB
LMS_GRPC_MAX_SEND_MSG_SIZE=25MB

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
LMS_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
LMS_CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
LMS_CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
LMS_CORS_ALLOW_CREDENTIALS=true
LMS_CORS_MAX_AGE=300

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LMS_LOG_LEVEL=info
LMS_LOG_FORMAT=json
LMS_LOG_FILE_PATH=/var/log/lms-service.log
LMS_LOG_MAX_SIZE=100MB
LMS_LOG_MAX_BACKUPS=3
LMS_LOG_MAX_AGE=28
LMS_LOG_COMPRESS=true

# =============================================================================
# HEALTH CHECK CONFIGURATION
# =============================================================================
LMS_HEALTH_CHECK_INTERVAL=15s
LMS_HEALTH_CHECK_TIMEOUT=5s
LMS_HEALTH_CHECK_RETRIES=3
LMS_GRPC_HEALTH_CHECK_SERVICE=grpc.health.v1.Health
LMS_DB_URL=postgresql://neondb_owner:npg_MEB4CYJS7TKh@ep-withered-salad-a27oo7gn-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# =============================================================================
# RATE LIMITING
# =============================================================================
LMS_RATE_LIMIT_ENABLED=true
LMS_RATE_LIMIT_REQUESTS_PER_MINUTE=100
LMS_RATE_LIMIT_BURST_SIZE=10
DB_MIGRATION=migrate -path database/migrations -database "postgresql://neondb_owner:npg_MEB4CYJS7TKh@ep-withered-salad-a27oo7gn-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require" up
# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
LMS_DEBUG_MODE=true
LMS_DEV_SKIP_AUTH=false
LMS_DEV_MOCK_DATA=false

LMS_REDIS_ADDRESS=
LMS_REDIS_PASSWORD=
LMS_DB_REDIS_ADDRESS=
LMS_NATS_URL=
LMS_SERVICE_ID=
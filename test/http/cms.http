### 1. Register
POST {{baseUrl}}/register
Content-Type: application/json

{
  "name": "John Doe",
  "email": "swanhtet102002@gmail.com",
  "password": "Password1231",
  "role": "CMS_CUSTOMER"
}

### 2. Verify Email
POST {{baseUrl}}/verify-email
Content-Type: application/json

{
  "email": "swanhtet102002@gmail.com",
  "code": "826127"
}

### Resend Email
POST {{baseUrl}}/resend
Content-Type: application/json

{
  "email": "swanhtet102002@gmail.com"
}
### 3. Login
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "swanhtet102002@gmail.com",
  "password": "Password1231"
}

### 4. Get Me (Profile)
GET {{baseUrl}}/me
Authorization: Bearer {{accessToken}}

### 5. Update User Profile
PUT {{baseUrl}}/profile/{{userId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "John Updated"
}

### 6. Setup MFA
POST {{baseUrl}}/mfa/setup/{{userId}}
Authorization: Bearer {{accessToken}}

### 7. Verify MFA Setup
POST {{baseUrl}}/mfa/verify/{{userId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "token_id": {{tokenId}},
    "code": "123456"
}

### 8. Login with MFA
POST {{baseUrl}}/mfa/login/{{userId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "mfa_code": "123456"
}

### 9. Refresh Token
POST {{baseUrl}}/refresh
Authorization: Bearer {{refreshToken}}
Content-Type: application/json

{
    "refresh_token": "{{refreshToken}}"
}

### 10. Logout
POST {{baseUrl}}/logout
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "refresh_token": "{{refreshToken}}"
}


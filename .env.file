# -----------------------------
# 📦 GitHub Integration
# -----------------------------
GITHUB_TOKEN=your_github_token
GITHUB_OWNER=your_github_org_or_username
GITHUB_REPO=your_repo_name

# -----------------------------
# 🌐 Application
# -----------------------------
PORT=9007

# -----------------------------
# 🧭 Consul Configuration
# -----------------------------
CONSUL_ADDRESS=consul:8500
CONSUL_DATACENTER=dc1
CONSUL_TOKEN=
CONSUL_SCHEME=http

# Automatically defaults to: cms-doc-api-<hostname>
CONSUL_SERVICE_ID=
CONSUL_SERVICE_NAME=cms-doc-multi-tenant-api

# Comma-separated list of tags
CONSUL_SERVICE_TAGS=cms-doc,multi-tenant,api

# TTL for Consul health check
CONSUL_CHECK_TTL=30s

# -----------------------------
# 🔐 Application Token (optional)
# -----------------------------
TOKEN=
